# Copy to .env. Never commit real keys. Generate one key per caller.
DEX_ANTHROPIC_API_KEY=replace-with-anthropic-key
DEX_MODEL=replace-with-supported-model-id
DEX_CLIENTS={"pad-test":{"key":"replace-with-random-secret-at-least-32-characters","tasks":["invoice.extract","delivery.extract"]}}
DEX_DATA_DIR=./data
DEX_HOST=127.0.0.1
DEX_PORT=8001
# Optional USD prices per million tokens for this exact model. Blank means unknown.
# DEX_INPUT_USD_PER_MILLION=0
# DEX_OUTPUT_USD_PER_MILLION=0
